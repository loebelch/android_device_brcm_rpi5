on property:sys.boot_completed=1
    start avtp-setup

service avtp-setup /vendor/bin/tsn-setup.sh
    class late_start
    user root
    group root net_raw net_admin inet
    capabilities NET_ADMIN NET_RAW
    oneshot
    disabled

# Optional: dauerhaft laufender Listener
